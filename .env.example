# ============================================================
# Abdalla Eissa for Design — Root-level scripts (.env)
# Copy this file to .env (in this same directory).
# .env is gitignored. NEVER commit real keys.
# ============================================================

# --- Supabase ------------------------------------------------
# Service role key bypasses RLS — full admin access. Server-only.
SUPABASE_URL=https://ukjwbcrbnutxemwsebsc.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# --- Unsplash ------------------------------------------------
# Create an app at https://unsplash.com/oauth/applications and copy
# the Access Key (NOT the Secret). Demo apps allow 50 requests/hour.
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# --- Gemini (Google AI Studio) -------------------------------
# Create a key at https://aistudio.google.com/app/apikey
# Free tier: gemini-1.5-flash, 15 RPM, 1500 requests/day.
GEMINI_API_KEY=your_gemini_api_key
