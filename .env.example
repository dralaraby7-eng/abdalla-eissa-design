# ============================================================
# Abdalla Eissa for Design — Root-level scripts (.env)
# Copy this file to .env (in this same directory).
# .env is gitignored. NEVER commit real keys.
# ============================================================

# --- Supabase ------------------------------------------------
# Service role key bypasses RLS — full admin access. Server-only.
SUPABASE_URL=https://ukjwbcrbnutxemwsebsc.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# --- Pexels (primary image source — 200 req/hour, up to 80/page) ---
# Create a key at https://www.pexels.com/api/new/
PEXELS_API_KEY=your_pexels_api_key

# --- Unsplash (alternate image source — 25–50 req/hour on demo) ---
# Create an app at https://unsplash.com/oauth/applications
# Only needed if you run seed_images.py with --source unsplash
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# --- Gemini (Google AI Studio) -------------------------------
# Create a key at https://aistudio.google.com/app/apikey
# Free tier: gemini-2.5-flash, 15 RPM, ~1500 requests/day.
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash

# --- Admin bootstrap (only for make_admin.py) ----------------
# Used once to create or promote an admin user.
ADMIN_EMAIL=you@example.com
# Leave ADMIN_TEMP_PASSWORD blank to auto-generate a random one.
# ADMIN_TEMP_PASSWORD=
