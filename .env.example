# ============================================================
# Abdalla Eissa for Design — Root-level scripts (.env)
# Copy this file to .env (in this same directory).
# .env is gitignored. NEVER commit real keys.
# ============================================================

# --- Supabase ------------------------------------------------
# Service role key bypasses RLS — full admin access. Server-only.
SUPABASE_URL=https://ukjwbcrbnutxemwsebsc.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ============================================================
# IMAGE SOURCES — pick one or set them all (script flag chooses)
# ============================================================

# --- Pexels (default — 200 req/hour, 80 photos/page) ---------
# https://www.pexels.com/api/new/
PEXELS_API_KEY=your_pexels_api_key

# --- Pixabay (most generous — 100 req/MINUTE, 200/page) ------
# https://pixabay.com/api/docs/
PIXABAY_API_KEY=your_pixabay_api_key

# --- Unsplash (best curation, slowest — 25-50/hour demo) -----
# https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# ============================================================
# LLM (meta_prompt generator) — pick one
# ============================================================

# --- Gemini direct (free tier: 15 RPM, ~1500 req/day) --------
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash

# --- OpenRouter (pay-per-call; uses your existing credit) ----
# https://openrouter.ai/keys
# Recommended cheapest vision model: google/gemini-2.5-flash-lite
# (≈ $0.10/M input, $0.40/M output → ~$1.50 for 1200 images)
OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# ============================================================
# Admin bootstrap (only for make_admin.py)
# ============================================================
ADMIN_EMAIL=you@example.com
# Leave blank to auto-generate a 16-char random password.
# ADMIN_TEMP_PASSWORD=
