# ============================================================
# Abdalla Eissa for Design — Backend Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# Supabase
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here   # Never expose this in frontend!

# Paymob
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_INTEGRATION_ID=your_integration_id    # Card payment integration ID
PAYMOB_IFRAME_ID=your_iframe_id
PAYMOB_HMAC_SECRET=your_hmac_secret          # For webhook verification

# Pricing (in EGP cents — Paymob uses smallest unit)
PRICE_MONTHLY_CENTS=19900     # 199 EGP
PRICE_YEARLY_CENTS=178800     # 149 * 12 = 1788 EGP

# App
FRONTEND_URL=http://localhost:5500            # Your frontend URL (for redirects)
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
