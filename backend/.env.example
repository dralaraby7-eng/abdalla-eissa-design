# ============================================================
# Abdalla Eissa for Design — Backend Environment Variables
# Copy this file to .env (local dev) or paste each KEY=VALUE
# into Render Dashboard → Environment (production).
# NEVER commit the real .env — it's in .gitignore.
# ============================================================

# --- Supabase ------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here   # SECRET — server only, never in frontend

# --- Paymob (Egyptian payments) ------------------------------
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_INTEGRATION_ID=your_integration_id
PAYMOB_IFRAME_ID=your_iframe_id
PAYMOB_HMAC_SECRET=your_hmac_secret               # Used to verify webhook authenticity

# --- Pricing (Paymob uses smallest unit — piastres) ----------
PRICE_LIFETIME_EGP_CENTS=25000                    # legacy fallback
PRICE_ALL_ACCESS_EGP_CENTS=25000                  # 250 EGP
PRICE_CATEGORY_EGP_CENTS=9900                     # 99 EGP per category

# --- App URLs ------------------------------------------------
# Local dev:
#   FRONTEND_URL=http://localhost:5500
#   ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Production (replace with your real Vercel URL):
FRONTEND_URL=https://your-frontend.vercel.app
ALLOWED_ORIGINS=https://your-frontend.vercel.app
ALLOW_VERCEL_PREVIEWS=false
